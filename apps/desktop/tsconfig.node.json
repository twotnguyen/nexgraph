{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@nexgraph/contracts/*": ["../../packages/contracts/src/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.mts", "playwright.config.ts", "src/main/**/*", "src/preload/**/*", "../../packages/contracts/src/**/*", "test/**/*", "e2e/**/*"]
}
