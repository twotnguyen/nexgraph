{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
    "baseUrl": ".",
    "paths": { "@nexgraph/contracts/*": ["../../packages/contracts/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "../../packages/contracts/src/**/*", "src/preload/index.d.ts"]
}
