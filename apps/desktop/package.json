    "ignore": "7.0.8",
    "pyright": "^1.1.414",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "typebox": "1.3.27",
    "typescript": "~5.9.3",
    "typescript-language-server": "^6.1.0"
  }
