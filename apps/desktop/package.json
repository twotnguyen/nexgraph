{
  "name": "@nexgraph/desktop",
  "productName": "NexGraph",
  "version": "0.1.2",
  "private": true,
  "description": "Ứng dụng desktop NexGraph",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
